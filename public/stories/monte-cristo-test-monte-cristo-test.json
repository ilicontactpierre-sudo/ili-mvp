        "I MARSEILLE. — L’ARRIVÉE."
      ],
      "text": "I MARSEILLE. — L’ARRIVÉE.",
      "breakAt": null,
      "isLeader": true,
      "audioEvents": [
        {
          "action": "fadeIn",
